{
  "name": "ghrank",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "description": "GitHub user and repository rankings without the Search API 1000-result ceiling",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "fetch:users": "tsx src/fetch-users.ts",
    "fetch:repos": "tsx src/fetch-repos.ts",
    "fetch": "pnpm fetch:users && pnpm fetch:repos",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "snapshot": "tsx src/snapshot.ts",
    "build": "pnpm fetch:users && pnpm fetch:repos && pnpm snapshot && pnpm compact",
    "build:site": "pnpm --filter ghrank-web build",
    "compact": "tsx src/compact.ts",
    "renorm": "tsx src/renorm.ts",
    "author": "tsx src/author.ts"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^5.18.6",
    "@kirklin/eslint-config": "^8.4.0",
    "@types/node": "^22.15.3",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
