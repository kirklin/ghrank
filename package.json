{
  "name": "ghrank",
  "type": "module",
  "version": "0.1.0",
  "packageManager": "pnpm@10.15.0",
  "description": "GitHub developer and repository rankings without the Search API 1000-result ceiling",
  "author": "Kirk Lin <dev@kirk.hk> (https://github.com/kirklin)",
  "license": "MIT",
  "homepage": "https://ghrank.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kirklin/ghrank.git"
  },
  "bugs": {
    "url": "https://github.com/kirklin/ghrank/issues"
  },
  "keywords": [
    "github",
    "github-api",
    "ranking",
    "leaderboard",
    "github-stars",
    "github-users",
    "developers",
    "open-source",
    "statistics"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "bin": {
    "ghrank": "./dist/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "fetch:users": "tsx src/fetch-users.ts",
    "fetch:repos": "tsx src/fetch-repos.ts",
    "fetch": "pnpm fetch:users && pnpm fetch:repos",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "snapshot": "tsx src/snapshot.ts",
    "build": "tsdown",
    "build:site": "pnpm --filter ghrank-web build",
    "compact": "tsx src/compact.ts",
    "renorm": "tsx src/renorm.ts",
    "prepublishOnly": "pnpm build",
    "build:data": "pnpm fetch:users && pnpm fetch:repos && pnpm snapshot && pnpm compact"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^5.18.6",
    "@kirklin/eslint-config": "^8.4.0",
    "@types/node": "^22.15.3",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "tsdown": "^0.22.14",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
